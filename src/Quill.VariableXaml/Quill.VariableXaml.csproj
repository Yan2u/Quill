<Project Sdk="Microsoft.NET.Sdk">

	<!-- The reconciler, VirtualStack and VariableXamlRoot: apply VNode trees to the WinUI object tree. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWinUI>true</UseWinUI>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Quill.VariableXaml.Model\Quill.VariableXaml.Model.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Quill.Playground" />
	</ItemGroup>

</Project>
