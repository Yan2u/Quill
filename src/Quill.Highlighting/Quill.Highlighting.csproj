<Project Sdk="Microsoft.NET.Sdk">

	<!-- Syntax highlighting for the source mode (11-source-mode.md, Q85) and later for code blocks (M6.3):
	     TextMate grammars and the Light+ / Dark+ themes through TextMateSharp. No UI dependency. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<!-- MIT; TextMateSharp depends on Onigwrap, the Oniguruma regex engine as a native library. -->
		<PackageReference Include="TextMateSharp" Version="2.0.4" />
		<PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Quill.Editor.Tests" />
	</ItemGroup>

</Project>
