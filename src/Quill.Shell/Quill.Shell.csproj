<Project Sdk="Microsoft.NET.Sdk">

	<!-- The application's pages and panels (13-app-shell.md): the sidebar (outline, files) and the pages the
	     navigation opens. Kept apart from the window so that the Playground's self-tests can host them. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWinUI>true</UseWinUI>
		<WindowsPackageType>None</WindowsPackageType>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Quill.Playground" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Quill.Editor\Quill.Editor.csproj" />
		<ProjectReference Include="..\Quill.Editor.WinUI\Quill.Editor.WinUI.csproj" />
		<ProjectReference Include="..\Quill.Settings\Quill.Settings.csproj" />
	</ItemGroup>

</Project>
