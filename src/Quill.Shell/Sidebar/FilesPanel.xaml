<UserControl
    x:Class="Quill.Shell.Sidebar.FilesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Quill.Shell.Sidebar"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The root folder's name; the full path is its tooltip. -->
        <TextBlock x:Name="FolderText" Margin="16,2,16,6" Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- The two views share this area: the tree wraps long names, the list cuts them short. -->
        <!--
            Folders and files have their own templates: a container is then reused only for an entry of the same
            kind. The tree works out a container's chevron before the template's bindings change it for the new
            entry (TreeViewList.PrepareContainerForItemOverride), and a reused folder container can mark the node of
            a file as having children; every item sets its node and chevron again from its own entry.
        -->
        <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{x:Bind Roots}" SelectionMode="Single"
                  CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                  Expanding="OnExpanding" ItemInvoked="OnItemInvoked">
            <TreeView.ItemTemplateSelector>
                <local:FileEntryTemplateSelector>
                    <local:FileEntryTemplateSelector.FolderTemplate>
                        <DataTemplate x:DataType="local:FileEntry">
                            <TreeViewItem ItemsSource="{x:Bind Children}" HorizontalContentAlignment="Stretch"
                                          HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                          DataContextChanged="OnItemDataContextChanged"
                                          AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="8" Padding="0,5,4,5" ToolTipService.ToolTip="{x:Bind Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </local:FileEntryTemplateSelector.FolderTemplate>
                    <local:FileEntryTemplateSelector.FileTemplate>
                        <DataTemplate x:DataType="local:FileEntry">
                            <TreeViewItem HorizontalContentAlignment="Stretch" HasUnrealizedChildren="False" GlyphOpacity="0"
                                          DataContextChanged="OnItemDataContextChanged"
                                          AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="8" Padding="0,5,4,5" ToolTipService.ToolTip="{x:Bind Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </local:FileEntryTemplateSelector.FileTemplate>
                </local:FileEntryTemplateSelector>
            </TreeView.ItemTemplateSelector>
        </TreeView>

        <ListView x:Name="List" Grid.Row="1" Visibility="Collapsed" ItemsSource="{x:Bind Files}"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnListItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileEntry">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Path}" AutomationProperties.Name="{x:Bind Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="16,8,16,8" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- The action bar: open a folder at the left, the view at the right. -->
        <Grid x:Name="ActionBar" Grid.Row="2" Padding="8" ColumnSpacing="8" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenFolderButton" Click="OnOpenFolderClick" HorizontalAlignment="Left" Padding="8,5,8,6"
                    ToolTipService.ToolTip="Open folder" AutomationProperties.Name="Open folder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock x:Name="OpenFolderText" Text="Open folder" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <toolkit:Segmented x:Name="ViewSwitch" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnViewSwitchChanged"
                               VerticalAlignment="Center" AutomationProperties.Name="Files view">
                <toolkit:SegmentedItem x:Name="TreeTab" ToolTipService.ToolTip="Tree" AutomationProperties.Name="Tree">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem x:Name="ListTab" ToolTipService.ToolTip="List" AutomationProperties.Name="List">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xEA37;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
            </toolkit:Segmented>
        </Grid>
    </Grid>
</UserControl>
