<UserControl
    x:Class="Quill.Shell.Pages.OpenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Quill.Shell.Pages">
    <UserControl.Resources>
        <Style x:Key="CommandCardStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="16,0,16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="960" Padding="40,28,40,40" Spacing="12" HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleText" Text="Open" Style="{StaticResource TitleTextBlockStyle}" />
            <Button x:Name="OpenFileButton" Style="{StaticResource CommandCardStyle}" Click="OnOpenClick" AutomationProperties.Name="Open file"
                    KeyboardAcceleratorPlacementMode="Hidden">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE8E5;" FontSize="18" />
                    <TextBlock x:Name="OpenFileText" Text="Open file..." VerticalAlignment="Center" />
                    <TextBlock Text="Ctrl+O" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="ImportHeading" Text="Import" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
            <Button x:Name="ImportButton" Style="{StaticResource CommandCardStyle}" IsEnabled="False" AutomationProperties.Name="Import">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE8B5;" FontSize="18" />
                    <TextBlock x:Name="ImportText" Text="Import..." VerticalAlignment="Center" />
                    <TextBlock Text="docx, wiki, rst, org" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="ImportUnavailableText" Text="Importing other formats is not available yet." Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock x:Name="RecentHeading" Text="Recent files" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Search..." TextChanged="OnSearchChanged" AutomationProperties.Name="Search recent files" />
                <Button x:Name="MoreButton" Grid.Column="1" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ClearItem" Text="Clear recent files" Click="OnClearClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Grid Padding="12,4,12,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ColumnNameText" Text="Name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ColumnFolderText" Grid.Column="1" Text="Folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
            <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRecentClick" Margin="-4,-8,-4,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RecentFileItem">
                        <Grid ColumnSpacing="16" Padding="0,8,0,8" ToolTipService.ToolTip="{x:Bind Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="No recent files." Visibility="Collapsed" Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
