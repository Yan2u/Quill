<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quill.Playground.Demos.LiveXamlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vx="using:Quill.Playground.VariableXaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid
            Padding="16,4,16,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="SampleBox"
                MinWidth="240"
                AutomationProperties.AutomationId="SampleBox"
                Header="Sample"
                SelectionChanged="OnSampleChanged">
                <ComboBoxItem Content="Starter" Tag="starter" />
                <ComboBoxItem Content="Rich text (RichTextBlock)" Tag="rich" />
                <ComboBoxItem Content="Article, 300 blocks (StackPanel)" Tag="article" />
                <ComboBoxItem Content="Article, 2000 blocks (vx:VirtualStack)" Tag="virtual" />
            </ComboBox>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="20">
                <CheckBox
                    x:Name="IncrementalPatchBox"
                    AutomationProperties.AutomationId="IncrementalPatchBox"
                    Click="OnOptionChanged"
                    Content="Incremental patching"
                    IsChecked="True"
                    ToolTipService.ToolTip="Off: discard the live tree and mount everything again on each change." />
                <CheckBox
                    x:Name="IncrementalParseBox"
                    Click="OnOptionChanged"
                    Content="Incremental parsing"
                    IsChecked="True"
                    ToolTipService.ToolTip="Re-parse only the element that encloses the edit." />
                <CheckBox
                    x:Name="XamlReaderBox"
                    Click="OnOptionChanged"
                    Content="Mount via XamlReader"
                    IsChecked="True"
                    ToolTipService.ToolTip="Create new subtrees with one XamlReader.Load instead of the reflection object model." />
                <CheckBox
                    x:Name="MeasureLayoutBox"
                    Click="OnOptionChanged"
                    Content="Measure layout"
                    IsChecked="True"
                    ToolTipService.ToolTip="Run a synchronous layout pass after each update and report its duration." />
            </StackPanel>
        </Grid>

        <!--  Markup editor | live preview  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="240" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Editor"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="MarkupEditor"
                AutomationProperties.Name="XAML markup"
                BorderThickness="0"
                CornerRadius="0"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="13"
                IsSpellCheckEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="OnEditorTextChanged"
                TextWrapping="NoWrap" />
            <toolkit:GridSplitter
                Grid.Column="1"
                Width="10"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Auto" />
            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <vx:VariableXamlRoot x:Name="Preview" AutomationProperties.AutomationId="Preview" />
            </Border>
        </Grid>

        <!--  Status  -->
        <StackPanel
            Grid.Row="2"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <InfoBar
                x:Name="DiagnosticsBar"
                Margin="12,8,12,0"
                AutomationProperties.AutomationId="DiagnosticsBar"
                IsClosable="False" />
            <InfoBar
                x:Name="EventBar"
                Margin="12,8,12,0"
                IsClosable="True"
                Severity="Success" />
            <TextBlock
                x:Name="StatusText"
                Margin="16,8,16,10"
                AutomationProperties.AutomationId="StatusText"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
