<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quill.Playground.Demos.StressTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vx="using:Quill.Playground.VariableXaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel Padding="16,8,16,16" Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Document stress test" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Simulates a Markdown editor: a block model with stable ids renders virtual nodes through the C# API, memoized per block version. Every update runs synchronously with a forced layout pass, so the timings below are pure update + layout cost."
                    TextWrapping="Wrap" />
                <NumberBox
                    x:Name="BlockCountBox"
                    AutomationProperties.AutomationId="BlockCountBox"
                    Header="Blocks"
                    LargeChange="1000"
                    Maximum="20000"
                    Minimum="10"
                    SmallChange="500"
                    SpinButtonPlacementMode="Compact"
                    Value="2000" />
                <NumberBox
                    x:Name="IterationsBox"
                    AutomationProperties.AutomationId="IterationsBox"
                    Header="Updates per operation"
                    Maximum="1000"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Value="40" />
                <ToggleSwitch
                    x:Name="VirtualizeSwitch"
                    AutomationProperties.AutomationId="VirtualizeSwitch"
                    Header="Block container"
                    OffContent="StackPanel (all blocks live)"
                    OnContent="vx:VirtualStack (virtualized)" />
                <ToggleSwitch
                    x:Name="IncrementalSwitch"
                    AutomationProperties.AutomationId="IncrementalSwitch"
                    Header="Update strategy"
                    IsOn="True"
                    OffContent="Full reload"
                    OnContent="Incremental patching" />
                <Button
                    x:Name="BuildButton"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="BuildButton"
                    Click="OnBuild"
                    Content="Build document"
                    Style="{StaticResource AccentButtonStyle}" />

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Operations (one update each)" />
                <Grid
                    x:Name="OperationButtons"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="TypeButton"
                        Click="OnType"
                        Content="Type in first paragraph" />
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RandomButton"
                        Click="OnRandomEdits"
                        Content="Random edits" />
                    <Button
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InsertButton"
                        Click="OnInsert"
                        Content="Insert blocks" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DeleteButton"
                        Click="OnDelete"
                        Content="Delete blocks" />
                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="MoveButton"
                        Click="OnMove"
                        Content="Move blocks" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Click="OnClearResults"
                        Content="Clear results" />
                </Grid>
                <ProgressBar x:Name="Progress" IsIndeterminate="False" />
                <TextBlock
                    x:Name="ResultsText"
                    AutomationProperties.AutomationId="ResultsText"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <vx:VariableXamlRoot
            x:Name="Host"
            Grid.Column="1"
            AutomationProperties.AutomationId="StressHost" />
    </Grid>
</UserControl>
